# Copy this file to `.env` (which is gitignored) and fill in your real values.
# NEVER commit the real .env. NEVER paste these secrets into chat.
#
#   cp .env.example .env
#   then edit .env with your Tastytrade OAuth credentials.

# Tastytrade — market data ONLY (no execution). Uses the official SDK's
# OAuth flow, which needs only the secret + refresh token.
TASTYTRADE_CLIENT_SECRET=your_client_secret_here   # = SDK provider_secret (required)
TASTYTRADE_REFRESH_TOKEN=your_refresh_token_here   # = SDK refresh_token   (required)
TASTYTRADE_CLIENT_ID=your_client_id_here           # OPTIONAL — unused by SDK OAuth
