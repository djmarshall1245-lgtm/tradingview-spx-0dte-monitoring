# Copy this file to `.env` (which is gitignored) and fill in your real values.
# NEVER commit the real .env. NEVER paste these secrets into chat.
#
#   cp .env.example .env
#   then edit .env with your Tastytrade OAuth credentials.

# Tastytrade — market data ONLY (no execution). OAuth2 refresh flow.
TASTYTRADE_CLIENT_ID=your_client_id_here
TASTYTRADE_CLIENT_SECRET=your_client_secret_here
TASTYTRADE_REFRESH_TOKEN=your_refresh_token_here
