{
  "mcpServers": {
    "tradingview": {
      "command": "node",
      "args": ["/Users/andrereynolds/tradingview-mcp-jackson/src/server.js"]
    },
    "tradingview-mcp": {
      "command": "node",
      "args": ["/Users/andrereynolds/tradingview-mcp-jackson/src/server.js"]
    },
    "unusualwhales": {
      "command": "sh",
      "args": ["-c", "npx -y mcp-remote https://api.unusualwhales.com/api/mcp --header \"Authorization: Bearer $UW_MCP_TOKEN\""]
    },
    "gemini": {
      "command": "npx",
      "args": ["-y", "gemini-mcp-tool"],
      "env": { "GEMINI_API_KEY": "${GEMINI_API_KEY}" }
    },
    "groq": {
      "command": "npx",
      "args": ["-y", "groq-compound-mcp-server"],
      "env": { "GROQ_API_KEY": "${GROQ_API_KEY}" }
    },
    "alpaca": {
      "command": "npx",
      "args": ["-y", "@alpaca-open-api/mcp"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY}",
        "ALPACA_API_SECRET": "${ALPACA_API_SECRET}",
        "ALPACA_TOOLSETS": "data"
      }
    }
  }
}
